{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/portal", "destination": "/index.html" },
    { "source": "/event", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/status", "destination": "/index.html" },
    { "source": "/review", "destination": "/index.html" },
    { "source": "/reviews", "destination": "/index.html" }
  ]
}
